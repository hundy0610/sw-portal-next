<?xml version="1.0" encoding="UTF-8"?>
<!--
  SW-PORTAL — 중앙 DB 일일 백업 launchd 에이전트 (콜드 스페어용)

  scripts/backup-central-db.sh 를 매일 새벽 2시에 실행해 pg_dump 를
  ~/swportal-backups/ 에 남긴다. Windows 콜드 스페어(scripts/restore-to-spare.ps1)가
  이 백업을 매일 새벽 2:30에 scp 로 가져가 복원한다 — 그래서 이 잡은 반드시
  2:30보다 앞서 끝나야 한다. 상세 설계: docs/COLD-SPARE-WINDOWS.md

  설치(맥북에서):
    cp deploy/com.swportal.backup-central-db.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.swportal.backup-central-db.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.swportal.backup-central-db.plist
    launchctl start com.swportal.backup-central-db     # 즉시 1회 실행(테스트)

  PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE 는 .env 에서 읽는다(backup-to-notion과
  동일 방식) — 이 파일엔 비밀값을 직접 넣지 않는다.
  로그: /tmp/swportal-backup-central-db.out / .err
  경로/사용자에 맞게 WorkingDirectory 를 확인하세요.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swportal.backup-central-db</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source .env; set +a; bash scripts/backup-central-db.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/user/works/SW-PORTAL</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/opt/postgresql/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/swportal-backup-central-db.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swportal-backup-central-db.err</string>
</dict>
</plist>
